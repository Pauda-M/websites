# PB Platform — environment template for the Docker Compose stack.
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Secrets policy: values here are DEV DEFAULTS ONLY. In staging/production,
# inject secrets via your orchestrator (Docker secrets, SSM, Vault, etc.).
# The API refuses to boot in production with placeholder secrets.

# --- Global ---
PB_ENVIRONMENT=development          # development | staging | production
COMPOSE_PROJECT_NAME=pb-platform

# --- Domains (Traefik routing) ---
PB_DOMAIN=localhost                 # base domain; api is served at api.${PB_DOMAIN}
PB_ACME_EMAIL=admin@example.com     # Let's Encrypt registration email (production)

# --- PostgreSQL ---
POSTGRES_USER=pb
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=pb_platform
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- API ---
PB_API_SECRET_KEY=dev-only-secret-key-change-me-0000000000000000
PB_API_ACCESS_TOKEN_EXPIRE_MINUTES=15
PB_API_REFRESH_TOKEN_EXPIRE_MINUTES=20160
PB_API_CORS_ORIGINS=["http://localhost:3000","https://localhost"]
PB_API_LOG_LEVEL=INFO
PB_API_RATE_LIMIT_PER_MINUTE=120

# --- Web ---
# Server-side base URL the web app uses to reach the API inside the compose network.
PB_WEB_API_INTERNAL_URL=http://api:8000
# Browser-facing base URL of the API (through Traefik).
NEXT_PUBLIC_API_URL=http://api.localhost
