# PB Platform — environment template for the Docker Compose stack.
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Secrets policy: values here are DEV DEFAULTS ONLY. In staging/production,
# inject secrets via your orchestrator (Docker secrets, SSM, Vault, etc.).
# The API refuses to boot in production with placeholder secrets.
#
# This file documents every variable the stack reads. A full reference with
# defaults and production-required flags lives in docs/CONFIGURATION.md.

# --- Global ---
PB_ENVIRONMENT=development          # development | staging | production | test
COMPOSE_PROJECT_NAME=pb-platform

# --- Domains (Traefik routing) ---
PB_DOMAIN=localhost                 # base domain; api is served at api.${PB_DOMAIN}
                                    # production example: pb-solutions.today
PB_ACME_EMAIL=admin@example.com     # Let's Encrypt registration email (production)

# --- PostgreSQL ---
POSTGRES_USER=pb
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=pb_platform
POSTGRES_PORT=5432                  # host-published port (dev only)

# --- Redis ---
REDIS_PORT=6379                     # host-published port (dev only)

# --- API: security ---
PB_API_SECRET_KEY=dev-only-secret-key-change-me-0000000000000000
PB_API_ACCESS_TOKEN_EXPIRE_MINUTES=15
PB_API_REFRESH_TOKEN_EXPIRE_MINUTES=20160   # 14 days
PB_API_PASSWORD_MIN_LENGTH=10

# --- API: HTTP behaviour ---
PB_API_CORS_ORIGINS=["http://localhost:3000","https://localhost"]
PB_API_TRUST_PROXY_HEADERS=false    # honour X-Forwarded-For (only behind our proxy)
PB_API_RATE_LIMIT_ENABLED=true
PB_API_RATE_LIMIT_PER_MINUTE=120

# --- API: database / cache tuning ---
# PB_API_DATABASE_URL and PB_API_REDIS_URL are derived from the values above in
# docker-compose.yml. Override them here only for out-of-compose runs.
PB_API_DATABASE_POOL_SIZE=10
PB_API_DATABASE_MAX_OVERFLOW=20

# --- API: observability ---
PB_API_LOG_LEVEL=INFO
# PB_API_LOG_JSON=            # unset -> JSON everywhere except development/test
PB_API_METRICS_ENABLED=true

# --- Web ---
# Server-side base URL the web app uses to reach the API inside the compose network.
PB_WEB_API_INTERNAL_URL=http://api:8000
# Browser-facing base URL of the API (through Traefik). NOTE: this is inlined
# into the client bundle at BUILD time, so a rebuild is required to change it.
NEXT_PUBLIC_API_URL=https://api.localhost
