# rh-meme-watch configuration. Copy to .env and fill in the token.
# NEVER commit .env (it is gitignored).

# --- required ---
TELEGRAM_BOT_TOKEN=

# --- optional (defaults shown) ---
TELEGRAM_CHAT_ID=5182460904
POLL_SEC=60
LIQ_FLOOR=150000
LIQ_FLOOR_STOCK=75000
NEW_WINDOW_MIN=180
ESC_VOL_H1=500000
MIN_LIQ=20000
# Liquidity-lock proxy (no on-chain LP lock is exposed by the API; this is
# inferred from recorded reserve history). 0 disables the gate.
REQUIRE_LIQ_LOCK=1
LOCK_MAX_DRAWDOWN=0.25
LOCK_MIN_AGE_MIN=30
LOCK_MIN_SAMPLES=10
# New-coin quality filter on NEW alerts. 0 disables a gate
# (MIN_PCT_H1: use a large negative number to disable).
MAX_FDV=5000000
MIN_LIQ_FDV_RATIO=0.02
MIN_BUYERS_H1=25
MIN_BUY_SELL_RATIO=1.0
MIN_TXNS_H1=50
MIN_AGE_MIN=10
MIN_PCT_H1=-15
# Social gate: the meme side of a NEW pool must expose at least one project
# social (X / Telegram / Discord / Farcaster / Zora). AND-ed with the liquidity
# floor. Set REQUIRE_SOCIALS=0 only as an escape hatch if the info API breaks.
REQUIRE_SOCIALS=1
SOCIAL_LOOKUPS_PER_CYCLE=6
SOCIAL_CACHE_TTL_SEC=21600
SOCIAL_MISS_TTL_SEC=300
# On-chain verification (Robinhood Chain RPC, chain 4663). Empty disables it.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
ONCHAIN_LOOKUPS_PER_CYCLE=4
ONCHAIN_CACHE_TTL_SEC=1800
CUSTODY_DROP_PCT=10
# LP custodians as addr=label pairs; defaults to the measured v2 custodian.
LP_CUSTODIANS=
DASHBOARD_PORT=8080
STOCK_SYMBOLS=AAPL,AMC,AMD,AMZN,BABA,BE,CRCL,CRWV,GOOGL,GOOG,INTC,META,MSFT,MU,NVDA,ORCL,PLTR,QQQ,SGOV,SLV,SNDK,SPCX,SPY,TSLA,USAR,HIMS,LLY,TTWO,GME,RBLX,QUBT,HOOD
LOG_LEVEL=INFO
TZ=Europe/Zurich
